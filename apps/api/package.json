{
  "name": "@pronunciation-mirror/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "prelint": "npm --workspace @pronunciation-mirror/core run build",
    "lint": "tsc --noEmit",
    "pretest": "npm --workspace @pronunciation-mirror/core run build && npm run verify:validation-content",
    "test": "node --test tests/*.test.mjs",
    "prebuild": "npm --workspace @pronunciation-mirror/core run build && npm run verify:validation-content",
    "verify:validation-content": "node ../../scripts/verify-validation-content.mjs",
    "build": "next build --webpack"
  },
  "dependencies": {
    "@pronunciation-mirror/core": "0.1.0",
    "next": "16.2.10",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "typescript": "6.0.3"
  }
}
