{
  "name": "@pronunciation-mirror/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "import": "./dist/v2/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "build": "tsc -p tsconfig.build.json",
    "smoke:import": "node --input-type=module --eval \"import('@pronunciation-mirror/core/v2').then((m) => { if (typeof m.createDailyPlan !== 'function') process.exit(1); })\""
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "typescript": "6.0.3"
  }
}
